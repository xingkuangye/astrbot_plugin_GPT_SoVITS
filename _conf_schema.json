{
    "enabled": {
        "description": "总开关",
        "type": "bool",
        "hint": "GPT-SoVITS 插件总开关，请在部署好 GPT-SoVITS 后再打开此开关",
        "default": true
    },
    "auto": {
        "description": "调用配置",
        "type": "object",
        "hint": "本插件有一定概率主动将bot本来要发送的文本转成语音发送",
        "items": {
            "only_llm_result": {
                "description": "只处理LLM结果",
                "type": "bool",
                "hint": "只处理 LLM 返回的消息。建议打开",
                "default": true
            },
            "tts_prob": {
                "description": "主动转语音发送的概率",
                "type": "float",
                "hint": "",
                "slider": {
                    "min": 0,
                    "max": 1,
                    "step": 0.01
                },
                "default": 0.15
            },
            "max_msg_len": {
                "description": "文本长度限制",
                "type": "int",
                "hint": "超过此长度的文本不会被转成语音发送",
                "slider": {
                    "min": 0,
                    "max": 200,
                    "step": 1
                },
                "default": 50
            }
        }
    },
    "client": {
        "description": "Index-TTS 客户端配置",
        "type": "object",
        "hint": "",
        "items": {
            "base_url": {
                "description": "Index-TTS API 的 URL",
                "type": "string",
                "hint": "Index-TTS 2.5 服务地址",
                "default": "http://127.0.0.1:7878"
            },
            "timeout": {
                "description": "Index-TTS API 请求超时时间",
                "hint": "单位为秒，仅约束单次 HTTP 请求，轮询由插件内部处理",
                "type": "int",
                "slider": {
                    "min": 30,
                    "max": 180,
                    "step": 1
                },
                "default": 60
            }
        }
    },
    "default_params": {
        "description": "TTS默认参数",
        "type": "object",
        "hint": "这些参数将用于每次语音合成请求，可根据需要调整",
        "items": {
            "text": {
                "description": "要转换为语音的文本",
                "type": "string",
                "hint": "支持任意语言，需与 lang 匹配",
                "default": ""
            },
            "ref_audio_path": {
                "description": "参考音频路径（音色克隆）",
                "type": "string",
                "hint": "上传给 Index-TTS 用于克隆音色的 wav，建议 5-15 秒清晰人声，必填",
                "default": "E:\\Unpacked Games\\星空列车与白的旅行\\またカップラーメンのつもりでしょ。うちに来なよ、お母さんが栄養あるもの作ってくれるって.wav"
            },
            "lang": {
                "description": "合成文本语言",
                "type": "string",
                "hint": "要转化的文本的语言",
                "options": [
                    "ZH",
                    "EN",
                    "JA",
                    "AR",
                    "ES"
                ],
                "labels": [
                    "中文",
                    "英语",
                    "日语",
                    "阿拉伯语",
                    "西班牙语"
                ],
                "default": "JA"
            },
            "duration_factor": {
                "description": "语速/时长系数",
                "type": "float",
                "hint": "0.5~2，越小越快",
                "slider": {
                    "min": 0.5,
                    "max": 2,
                    "step": 0.05
                },
                "default": 1.0
            },
            "max_text_tokens_per_segment": {
                "description": "分句最大 token",
                "type": "int",
                "hint": "影响长文本分句长度",
                "slider": {
                    "min": 30,
                    "max": 300,
                    "step": 10
                },
                "default": 120
            },
            "emo_control_method": {
                "description": "情感控制方式",
                "type": "int",
                "hint": "0=同音色参考 1=情感参考音频 2=情感向量 3=情感描述",
                "default": 0
            },
            "emo_weight": {
                "description": "情感强度",
                "type": "float",
                "hint": "0~1，仅情感控制时生效",
                "slider": {
                    "min": 0,
                    "max": 1,
                    "step": 0.05
                },
                "default": 0.65
            },
            "media_type": {
                "description": "输出音频格式",
                "type": "string",
                "hint": "Index-TTS 固定返回 wav",
                "options": [
                    "wav"
                ],
                "default": "wav"
            }
        }
    },
    "judge": {
        "description": "LLM 配置",
        "hint": "",
        "type": "object",
        "items": {
            "enabled_llm": {
                "description": "使用 LLM 判断情感",
                "type": "bool",
                "hint": "开启后，将使用 LLM 模型判断当前文本的情绪，从而改变语音的情绪参数。若关闭， 则使用情绪条目的触发词来匹配情绪",
                "default": false
            },
            "provider_id": {
                "description": "判断情感用的LLM提供商",
                "type": "string",
                "default": "",
                "hint": "留空或者填写的提供商不存在时, 则使用当前正在使用的LLM提供商。 tip:工作较为简单，建议用稳定便宜又快速的小模型",
                "_special": "select_provider"
            }
        }
    },
    "cache": {
        "description": "缓存配置",
        "type": "object",
        "hint": "",
        "items": {
            "enabled": {
                "description": "启用语音缓存",
                "hint": "开启后，请求参数一致时直接复用本地缓存音频，减少重复推理",
                "type": "bool",
                "default": true
            },
            "expire_hours": {
                "description": "缓存过期时间(h)",
                "hint": "单位为小时。 0 表示永不过期，大于 0 时按文件修改时间判断是否过期",
                "type": "int",
                "slider": {
                    "min": 0,
                    "max": 240,
                    "step": 1
                },
                "default": 0
            },
            "path": {
                "description": "缓存路径",
                "hint": "请使用 “/” 分隔路径，支持绝对路径和相对路径；留空时默认 data/plugins_data/astrbot_plugin_GPT_SoVITS/audio",
                "type": "string",
                "default": "data/plugins_data/astrbot_plugin_GPT_SoVITS/audio"
            }
        }
    },
    "entry_storage": {
        "description": "情绪参数配置",
        "hint": "可自定义多套情绪参数，并定义对应触发词。由此实现不同情绪的语音",
        "type": "template_list",
        "templates": {
            "default": {
                "name": "情绪条目",
                "items": {
                    "name": {
                        "description": "情绪名",
                        "type": "string",
                        "hint": "用于查询与显示，请确保名称唯一",
                        "default": "请输入情绪名"
                    },
                    "keywords": {
                        "description": "触发词",
                        "type": "list",
                        "hint": "AI回复词中含有列表中的任一关键词时, 将使用此套的情绪参数",
                        "default": []
                    },
                    "ref_audio_path": {
                        "description": "参考音频文件路径",
                        "type": "string",
                        "hint": "请使用 “/” 分隔路径，支持绝对路径和相对路径",
                        "default": ""
                    },
                    "duration_factor": {
                        "description": "语速/时长系数",
                        "type": "float",
                        "hint": "0.5~2，越小越快",
                        "slider": {
                            "min": 0.5,
                            "max": 2,
                            "step": 0.05
                        },
                        "default": 1
                    },
                    "emo_control_method": {
                        "description": "情感控制方式",
                        "type": "int",
                        "hint": "0=同音色参考 1=情感参考音频 2=情感向量 3=情感描述",
                        "default": 0
                    },
                    "emo_weight": {
                        "description": "情感强度",
                        "type": "float",
                        "hint": "0~1",
                        "slider": {
                            "min": 0,
                            "max": 1,
                            "step": 0.05
                        },
                        "default": 0.65
                    }
                }
            }
        }
    }
}